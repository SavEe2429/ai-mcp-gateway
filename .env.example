# AI Agent MCP Gateway Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# Optional path overrides (useful when running standalone or in tests)
# GATEWAY_CONFIG_PATH=config/config.yaml
# GATEWAY_DATA_DIR=data
# GATEWAY_DB_PATH=data/gateway.db
# GATEWAY_WORKSPACE_DIR=workspace
# GATEWAY_CLIENT_SECRET_FILE=data/client_secret.key

# OAuth Client Credentials (optional overrides over config/config.yaml)
# MCP_CLIENT_ID=local-mcp
# MCP_CLIENT_SECRET=change-this-to-a-secure-random-token-in-production
